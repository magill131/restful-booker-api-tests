          "path": [
            "booking",
            "{{bookingId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstname\": \"Chris\",\n  \"lastname\": \"Updated\",\n  \"totalprice\": 999,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2026-11-01\",\n    \"checkout\": \"2026-11-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Update booking - with token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"All fields updated\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.lastname).to.eql(\"Updated\");",
              "  pm.expect(body.totalprice).to.eql(999);",
              "  pm.expect(body.depositpaid).to.eql(false);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/booking/{{bookingId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "booking",
            "{{bookingId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstname\": \"Chris\",\n  \"lastname\": \"Updated\",\n  \"totalprice\": 999,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2026-11-01\",\n    \"checkout\": \"2026-11-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
